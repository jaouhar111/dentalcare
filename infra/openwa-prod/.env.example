# OpenWA production env — copy to `.env` next to docker-compose.yml.
#
# Only ALLOWED_CIDRS is read by the compose file directly; the rest
# are documentation reminders of what to set INSIDE OpenWA (via its
# `/api/auth/api-keys` and `/api/sessions/.../webhooks` endpoints) once
# the container is up.

# ── docker-compose ──────────────────────────────────────────────────
# Whitelist that fronts the REST API. Recommended: Vercel egress +
# your office IP. Get Vercel's CIDR list from:
#   https://vercel.com/docs/edge-network/regions
# Example (single Vercel region + Maroc):
#   ALLOWED_CIDRS=76.76.21.0/24,196.65.0.0/16
ALLOWED_CIDRS=0.0.0.0/0

# ── DentalCare (Vercel project env) ─────────────────────────────────
# Add these in https://vercel.com/<team>/<project>/settings/environment-variables
# DO NOT add them to this file — they live next to the Next.js app, not
# next to OpenWA. They are listed here so the deployment runbook is
# self-contained.
#
# OPENWA_BASE_URL=https://openwa.dentalcare.ma
# OPENWA_API_KEY=<32+ random hex bytes, rotate every 90 days>
# OPENWA_WEBHOOK_SECRET=<32+ random hex bytes, rotate every 90 days>
