// DentalCare — Prisma schema (Prisma 7+)
// Datasource URLs live in ../prisma.config.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Minimal key/value table (runtime config + DB pipeline sanity check).
model Meta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("meta")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant + identity
// ─────────────────────────────────────────────────────────────────────────────

/// Cabinet = tenant. Every domain row is scoped by `clinicId` (multi-tenant prep).
/// Subscription state of a cabinet. Drives the marketing-site CTA
/// ("Try free for 14 days") and gates dashboard access when the
/// trial expires or billing fails. Wired to Stripe later — for now
/// the value is set by the signup flow + admin actions.
enum SubscriptionStatus {
  /// Default for fresh sign-ups. Full feature access for 14 days.
  TRIAL
  /// Paid subscription in good standing.
  ACTIVE
  /// Stripe webhook reported a failed renewal. Dashboard read-only.
  PAST_DUE
  /// Admin cancelled or trial expired without conversion.
  CANCELLED

  @@map("subscription_status")
}

/// Plan tier mirrors the 3 cards on the landing pricing section.
/// `STARTER`     = 0 MAD/month, 1 dentist, 100 patients.
/// `PRO`         = 499 MAD/month, AI bot, recalls, plans.
/// `CABINET_PLUS`= 999 MAD/month, unlimited everything + voice.
enum SubscriptionPlan {
  STARTER
  PRO
  CABINET_PLUS

  @@map("subscription_plan")
}

/// Tone for the AI Receptionist's WhatsApp replies. Drives the system
/// prompt the engine builds for each tenant.
enum AIReceptionistStyle {
  /// "Bonjour Madame, je vous prie de bien vouloir…"
  FORMAL
  /// "Salut Sara, je te propose mardi 14h, ça te va ?"
  FRIENDLY

  @@map("ai_receptionist_style")
}

model Clinic {
  id                    String   @id @default(cuid())
  name                  String
  /// URL-safe identifier — used for marketing subdomains
  /// (`hdoud-otmane.dentalcare.ma`) and for the public booking
  /// portal route. Generated from `name` at signup, lowercased,
  /// dash-separated, deduped with a numeric suffix on collision.
  /// Nullable while we backfill pre-existing clinics; the signup
  /// flow always sets it, so new rows are guaranteed to carry one.
  slug                  String?  @unique
  address               String?
  phone                 String?
  email                 String?
  vatNumber             String?
  logoUrl               String?
  defaultLocale         String   @default("fr")
  /// Random starting invoice number in [1000, 9999] generated at creation
  /// — obscures billing volume (cf. SPEC §4.8).
  invoiceStartingNumber Int
  settingsJson          Json?
  /// Meta phone-number-id this cabinet's WhatsApp is bound to.
  /// Inbound webhooks carry it in `metadata.phone_number_id` —
  /// Legacy — Meta Cloud API `phone_number_id`. Kept for migration
  /// purposes only. New deployments use `openwaSessionId` (OpenWA
  /// gateway). Safe to read but no new code should set this field.
  whatsappPhoneId       String?  @unique
  /// OpenWA session UUID — the gateway's per-cabinet WhatsApp Web
  /// session. Set when the cabinet completes the QR-onboarding flow in
  /// `/settings/ai-receptionist`. Webhook routing uses this to find the
  /// clinic when an inbound message lands. Null = onboarding pending.
  openwaSessionId       String?  @unique
  subscriptionStatus    SubscriptionStatus @default(TRIAL)
  /// Which landing-page tier this cabinet is on. Defaults to PRO so a
  /// fresh signup on TRIAL gets the most-popular set of features for
  /// the trial window; the SUPER_ADMIN can move them to STARTER or
  /// CABINET_PLUS from /super-admin/clinics/[id].
  plan                  SubscriptionPlan   @default(PRO)
  trialEndsAt           DateTime?
  /// Timestamp when the cabinet completed the 5-step onboarding wizard.
  /// `null` = wizard never completed → /onboarding page blocks all other
  /// routes until the cabinet finishes setup (or explicitly skips).
  onboardingCompletedAt DateTime?
  /// Platform-owner suspension — independent of billing status. When set,
  /// every non-SUPER_ADMIN user of the cabinet is locked out (redirected
  /// to /suspended) regardless of subscription state. Cleared on reactivate.
  suspendedAt           DateTime?
  suspendedReason       String?
  /// Per-cabinet feature overrides set by the super-admin (P2-10). `null`
  /// = use the plan default; `true`/`false` force the feature on/off
  /// regardless of plan (e.g. enable AI for a demo cabinet on Starter).
  /// Applied in `capabilitiesFor` when passed through.
  featureAiReceptionist Boolean?
  featureVoiceNotes     Boolean?
  featureRecalls        Boolean?
  featurePaymentPlans   Boolean?
  /// AI Receptionist kill switch. `true` = bot answers WhatsApp inbound.
  /// `false` = bot replies with a "transferring you" message and creates
  /// a handover ticket so the cabinet team picks up manually. Defaults
  /// to true per the Phase 10 positioning ("AI ON by default").
  aiEnabled             Boolean            @default(true)
  /// Tone used by the bot when composing replies.
  aiStyle               AIReceptionistStyle @default(FRIENDLY)
  /// Signature appended to every bot reply (e.g. "— Cabinet Hdoud").
  /// Empty by default; the cabinet sets it in the AI Receptionist
  /// settings page.
  aiSignature           String?            @db.VarChar(80)
  /// Cabinet-customised templates that override the bot defaults for
  /// the 5 most common interaction types (book RDV, urgence, opening
  /// hours, address, off-topic). Shape: `{ bookRdv?: string; ... }`.
  /// Null = use built-in defaults.
  aiTemplatesJson       Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users                 User[]
  patients              Patient[]
  dentists              Dentist[]
  appointments          Appointment[]
  waitlistEntries       WaitlistEntry[]
  medicalNotes          MedicalNote[]
  radiographs           Radiograph[]
  treatmentPhotos       TreatmentPhoto[]
  treatmentCatalog      TreatmentCatalogItem[]
  treatmentApplications TreatmentApplication[]
  dentalChartEntries    DentalChartEntry[]
  prescriptions         Prescription[]
  invoices              Invoice[]
  payments              Payment[]
  paymentPlans          PaymentPlan[]
  stockItems            StockItem[]
  stockMovements        StockMovement[]
  recallReminders       RecallReminder[]
  aiConversations       AIConversation[]
  supportTickets        SupportTicket[]

  @@map("clinics")
}

enum UserRole {
  /// Platform owner. Cross-tenant access (every clinic), super-admin
  /// dashboard, audit log, billing controls. Not delegable.
  SUPER_ADMIN
  ADMIN
  DENTIST
  RECEPTIONIST

  @@map("user_role")
}

/// Application user. Email globally unique to keep multi-clinic invitations easy.
model User {
  id           String    @id @default(cuid())
  clinicId     String
  email        String    @unique
  passwordHash String
  role         UserRole
  fullName     String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  /// Set only on a SUPER_ADMIN row while they impersonate a cabinet user
  /// (support). The session callback reads it to swap the effective
  /// identity; cleared when impersonation stops.
  impersonatedUserId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clinic               Clinic                 @relation(fields: [clinicId], references: [id])
  resetTokens          PasswordResetToken[]
  createdPatients      Patient[]              @relation("PatientCreator")
  createdAppointments  Appointment[]          @relation("AppointmentCreator")
  createdMedicalNotes  MedicalNote[]          @relation("MedicalNoteAuthor")
  uploadedRadiographs  Radiograph[]           @relation("RadiographUploader")
  uploadedPhotos       TreatmentPhoto[]       @relation("PhotoUploader")
  createdTreatmentApps TreatmentApplication[] @relation("TreatmentApplicationCreator")
  recordedChartEntries DentalChartEntry[]     @relation("DentalChartRecorder")
  createdPrescriptions Prescription[]         @relation("PrescriptionCreator")
  createdInvoices      Invoice[]              @relation("InvoiceCreator")
  recordedPayments     Payment[]              @relation("PaymentCreator")
  createdPaymentPlans  PaymentPlan[]          @relation("PaymentPlanCreator")
  recordedStockMoves   StockMovement[]        @relation("StockMovementCreator")
  createdRecalls       RecallReminder[]       @relation("RecallCreator")
  aiConversationHandovers AIConversation[]    @relation("AIConversationHandover")
  /// Reverse 1-1 — set when this user IS a dentist (and only then).
  dentist              Dentist?               @relation("UserDentist")
  /// Support tickets this user opened (cabinet-side) OR replied to
  /// (either side). Two separate relations so we keep the audit trail
  /// of WHO created vs WHO last responded clean.
  openedSupportTickets SupportTicket[]        @relation("SupportTicketCreator")
  supportTicketReplies SupportTicketReply[]   @relation("SupportTicketReplyAuthor")

  @@index([clinicId])
  @@index([role])
  @@map("users")
}

/// One-shot password reset token. Stored hashed, single-use, 30-min expiry.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Patients
// ─────────────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE

  @@map("blood_group")
}

enum CommunicationChannel {
  WHATSAPP
  EMAIL
  PHONE

  @@map("communication_channel")
}

/// Patient record. Soft-deleted via `deletedAt` (rétention 5 ans cf. loi 09-08).
model Patient {
  id               String               @id @default(cuid())
  clinicId         String
  firstName        String
  lastName         String
  cin              String?
  phone            String
  email            String?
  dob              DateTime             @db.Date
  gender           Gender?
  address          String?
  city             String?
  bloodGroup       BloodGroup?
  photoUrl         String?
  medicalHistory   String?
  /// Preferred communication channel for reminders + recall (cf. SPEC §4.2 / §4.4.1).
  preferredChannel CommunicationChannel @default(WHATSAPP)
  /// Preferred UI / template locale ("fr" | "en" | "ar").
  preferredLocale  String               @default("fr")
  /// Patient consent for before/after treatment photos (cf. SPEC §4.5).
  photoConsent     Boolean              @default(false)
  photoConsentAt   DateTime?
  deletedAt        DateTime?
  createdById      String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  clinic                Clinic                 @relation(fields: [clinicId], references: [id])
  createdBy             User                   @relation("PatientCreator", fields: [createdById], references: [id])
  allergies             PatientAllergy[]
  appointments          Appointment[]
  waitlistEntries       WaitlistEntry[]
  medicalNotes          MedicalNote[]
  radiographs           Radiograph[]
  treatmentPhotos       TreatmentPhoto[]
  treatmentApplications TreatmentApplication[]
  dentalChartEntries    DentalChartEntry[]
  prescriptions         Prescription[]
  invoices              Invoice[]
  paymentPlans          PaymentPlan[]
  recallReminders       RecallReminder[]
  aiConversations       AIConversation[]

  // CIN is unique within a clinic when present. Postgres treats NULLs as distinct,
  // so multiple patients without CIN are allowed.
  @@unique([clinicId, cin])
  @@index([clinicId, deletedAt])
  @@index([clinicId, lastName, firstName])
  @@map("patients")
}

model PatientAllergy {
  id        String @id @default(cuid())
  patientId String
  label     String

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_allergies")
}

// ─────────────────────────────────────────────────────────────────────────────
// Dentists + schedules + absences
// ─────────────────────────────────────────────────────────────────────────────

/// A practitioner. May be linked to a {@link User} (when they have a login),
/// or stand alone (e.g. external consultant only present on the agenda).
model Dentist {
  id        String   @id @default(cuid())
  clinicId  String
  /// Optional 1-1 link with the {@link User} who can sign in. NULL = "no login".
  userId    String?  @unique
  firstName String
  lastName  String
  specialty String?
  phone     String?
  email     String?
  /// Hex color for the appointment calendar (cf. SPEC §4.3, mockup appointments.html).
  color     String   @default("#0891B2")
  photoUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic                Clinic                 @relation(fields: [clinicId], references: [id])
  user                  User?                  @relation("UserDentist", fields: [userId], references: [id])
  schedules             WorkingSchedule[]
  absences              DentistAbsence[]
  appointments          Appointment[]
  waitlistEntries       WaitlistEntry[]
  radiographs           Radiograph[]
  treatmentPhotos       TreatmentPhoto[]
  treatmentApplications TreatmentApplication[]
  prescriptions         Prescription[]

  @@index([clinicId, isActive])
  @@map("dentists")
}

/// One row per (dentist × day × time range). Multi-plage = multiple rows
/// for the same (dentistId, dayOfWeek).
///
/// `dayOfWeek` follows ISO-8601 with Sunday=0..Saturday=6.
/// `startTime`/`endTime` are "HH:MM" 24-hour strings (kept as text to dodge
/// timezone math on a pure clock-time concept).
model WorkingSchedule {
  id        String @id @default(cuid())
  dentistId String
  dayOfWeek Int
  startTime String
  endTime   String

  dentist Dentist @relation(fields: [dentistId], references: [id], onDelete: Cascade)

  @@index([dentistId, dayOfWeek])
  @@map("working_schedules")
}

/// Punctual absence (vacation, training, sick day…). Both `startAt` and
/// `endAt` are full timestamps so half-day absences are expressable.
model DentistAbsence {
  id        String   @id @default(cuid())
  dentistId String
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())

  dentist Dentist @relation(fields: [dentistId], references: [id], onDelete: Cascade)

  @@index([dentistId, startAt])
  @@map("dentist_absences")
}

// ─────────────────────────────────────────────────────────────────────────────
// Appointments
// ─────────────────────────────────────────────────────────────────────────────

/// Channel that originated the appointment — surfaces in the UI so
/// admins can distinguish bot-booked RDV from manual entries, and
/// powers per-source analytics (e.g. % of bookings handled by AI).
enum AppointmentSource {
  /// Default — created from the dashboard by a human user.
  MANUAL
  /// Booked by the WhatsApp AI booking flow via `create_appointment`.
  AI_WHATSAPP
  /// Created by a recall follow-up (future automation).
  RECALL_FOLLOWUP
  /// Created from a waitlist proposal accepted by the patient.
  WAITLIST_ACCEPT

  @@map("appointment_source")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULE_REQUESTED

  @@map("appointment_status")
}

enum WaitlistStatus {
  WAITING
  PROPOSED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED

  @@map("waitlist_status")
}

enum WaitlistTimePreference {
  ANY
  MORNING
  AFTERNOON

  @@map("waitlist_time_preference")
}

/// A patient appointment with a dentist.
///
/// Conflict detection (no two appointments overlapping for the same dentist)
/// is enforced at Server Action level — see `createAppointment` in
/// `server/actions/appointments.ts`. We could add a Postgres exclusion
/// constraint later, but in practice the action-level check is simpler and
/// matches the user-facing error contract.
model Appointment {
  id                     String            @id @default(cuid())
  clinicId               String
  patientId              String
  dentistId              String
  startAt                DateTime
  endAt                  DateTime
  status                 AppointmentStatus @default(SCHEDULED)
  reason                 String?
  notes                  String?
  /// 32-byte URL-safe token used by the J-1 WhatsApp/email reminder to let
  /// the patient confirm or request a reschedule with a single click.
  /// Generated lazily when the first reminder is queued.
  confirmationToken      String?           @unique
  reminderSentAt         DateTime?
  /// Same-day morning reminder timestamp (separate from J-1 above).
  /// The 08:00 Casablanca cron sweep stamps this so the same patient
  /// never gets two morning reminders for the same RDV across retries.
  morningReminderSentAt  DateTime?
  confirmationReceivedAt DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?
  /// `true` when the patient cancelled less than 24h before the start —
  /// useful for cabinet stats (no-show rate proxy).
  cancelledLate          Boolean           @default(false)
  /// Where this RDV came from. NULL fallback would be ambiguous — every
  /// row carries a source so dashboards / filters can group cleanly.
  source                 AppointmentSource @default(MANUAL)
  createdById            String
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  clinic                Clinic                 @relation(fields: [clinicId], references: [id])
  patient               Patient                @relation(fields: [patientId], references: [id])
  dentist               Dentist                @relation(fields: [dentistId], references: [id])
  createdBy             User                   @relation("AppointmentCreator", fields: [createdById], references: [id])
  treatmentApplications TreatmentApplication[]
  prescriptions         Prescription[]

  @@index([clinicId, startAt])
  @@index([dentistId, startAt])
  @@index([patientId, startAt])
  @@index([status])
  @@map("appointments")
}

/// Patient on the waitlist for an earlier slot.
///
/// `dentistId == NULL` = any dentist accepted. `timePreference` narrows the
/// matchable window; if `notBefore` / `notAfter` are set, the candidate is
/// only matched to slots strictly inside that window. `expiresAt` clears the
/// entry from the queue (admin can extend by editing).
model WaitlistEntry {
  id             String                 @id @default(cuid())
  clinicId       String
  patientId      String
  dentistId      String?
  durationMin    Int                    @default(30)
  timePreference WaitlistTimePreference @default(ANY)
  /// Patient won't accept a slot before this date (e.g. holidays).
  notBefore      DateTime?
  /// Hard deadline; entry auto-expires after this date.
  notAfter       DateTime?
  status         WaitlistStatus         @default(WAITING)
  reason         String?

  // Set when a slot is proposed.
  proposedAt             DateTime?
  proposedExpiresAt      DateTime?
  /// The cancelled appointment slot we are offering.
  proposedSlotStart      DateTime?
  proposedSlotEnd        DateTime?
  /// Public token the patient uses to accept/decline the proposal.
  proposalToken          String?   @unique
  /// Once `ACCEPTED`, this points to the newly created appointment.
  resultingAppointmentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic  Clinic   @relation(fields: [clinicId], references: [id])
  patient Patient  @relation(fields: [patientId], references: [id])
  dentist Dentist? @relation(fields: [dentistId], references: [id])

  @@index([clinicId, status, createdAt])
  @@index([patientId])
  @@map("waitlist_entries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// Medical records (notes + radiographs + treatment photos)
// ─────────────────────────────────────────────────────────────────────────────

enum RadiographKind {
  PANORAMIC
  PERIAPICAL
  BITEWING
  CEPHALOMETRIC
  CBCT
  OCCLUSAL
  OTHER

  @@map("radiograph_kind")
}

enum TreatmentPhotoStage {
  BEFORE
  DURING
  AFTER

  @@map("treatment_photo_stage")
}

/// Free-form medical note attached to a patient (and optionally to a specific
/// appointment). Used for clinical observations, treatment plans, follow-up
/// instructions. The note `body` is stored as plain text — rich text can be
/// layered on later without a schema change.
model MedicalNote {
  id            String   @id @default(cuid())
  clinicId      String
  patientId     String
  appointmentId String?
  authorId      String
  /// Short label rendered on the timeline (e.g. "Examen initial").
  title         String?
  body          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  author  User    @relation("MedicalNoteAuthor", fields: [authorId], references: [id])

  @@index([clinicId, patientId, createdAt])
  @@index([appointmentId])
  @@map("medical_notes")
}

/// Radiographic image attached to a patient. Files are stored in Cloudinary;
/// the schema only keeps the `publicId` (used to build signed delivery URLs)
/// plus indexing metadata. `takenAt` is set by the user — defaults to upload
/// time if omitted.
model Radiograph {
  id           String         @id @default(cuid())
  clinicId     String
  patientId    String
  dentistId    String?
  kind         RadiographKind @default(PANORAMIC)
  /// Cloudinary public_id (stable identifier — used to sign delivery URLs).
  publicId     String         @unique
  /// File format extension reported by Cloudinary ("png", "jpg", "pdf"…).
  format       String?
  bytes        Int?
  width        Int?
  height       Int?
  takenAt      DateTime
  note         String?
  uploadedById String
  createdAt    DateTime       @default(now())

  clinic     Clinic   @relation(fields: [clinicId], references: [id])
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentist    Dentist? @relation(fields: [dentistId], references: [id])
  uploadedBy User     @relation("RadiographUploader", fields: [uploadedById], references: [id])

  @@index([clinicId, patientId, takenAt])
  @@index([kind])
  @@map("radiographs")
}

/// Before/during/after clinical photo. Requires `patient.photoConsent = true`
/// at upload time (enforced in the Server Action — see SPEC §4.5).
model TreatmentPhoto {
  id            String              @id @default(cuid())
  clinicId      String
  patientId     String
  dentistId     String?
  appointmentId String?
  stage         TreatmentPhotoStage @default(BEFORE)
  /// Cloudinary public_id.
  publicId      String              @unique
  format        String?
  bytes         Int?
  width         Int?
  height        Int?
  caption       String?
  uploadedById  String
  createdAt     DateTime            @default(now())

  clinic     Clinic   @relation(fields: [clinicId], references: [id])
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentist    Dentist? @relation(fields: [dentistId], references: [id])
  uploadedBy User     @relation("PhotoUploader", fields: [uploadedById], references: [id])

  @@index([clinicId, patientId, createdAt])
  @@index([appointmentId])
  @@map("treatment_photos")
}

// ─────────────────────────────────────────────────────────────────────────────
// Treatments (Phase 6 — catalog + per-séance applications)
// ─────────────────────────────────────────────────────────────────────────────

enum ToothSurface {
  MESIAL
  DISTAL
  OCCLUSAL
  VESTIBULAR
  LINGUAL
  INCISAL

  @@map("tooth_surface")
}

enum TreatmentApplicationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("treatment_application_status")
}

/// A reusable treatment definition for the clinic's catalog. Each `code` is
/// unique within a clinic so receptionists can quote it quickly and reports
/// can aggregate by treatment type. `defaultPrice` seeds new applications;
/// dentists can override per case.
model TreatmentCatalogItem {
  id                 String   @id @default(cuid())
  clinicId           String
  /// Short alphanumeric code chosen by the clinic (e.g. "DET", "COMP1").
  code               String
  name               String
  description        String?
  /// Default price in MAD. Stored as Decimal(10,2) — covers up to 99 999 999.99 DH.
  defaultPrice       Decimal  @db.Decimal(10, 2)
  defaultDurationMin Int      @default(30)
  /// UI hint — when true, the application form will surface the tooth/surface
  /// picker. Treatments like scaling don't need a tooth so default is false.
  requiresTooth      Boolean  @default(false)
  /// Hex color used on the odontogram (Phase 7) to mark dents with this act.
  color              String   @default("#0891B2")
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(100)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clinic       Clinic                 @relation(fields: [clinicId], references: [id])
  applications TreatmentApplication[]

  @@unique([clinicId, code])
  @@index([clinicId, isActive])
  @@map("treatment_catalog")
}

/// An instance of a catalog item applied to a patient. May be linked to a
/// specific appointment (the séance during which the act was performed) and
/// optionally to a tooth + surfaces. Pricing is captured at the time of
/// application so future catalog price changes don't rewrite history.
model TreatmentApplication {
  id             String                     @id @default(cuid())
  clinicId       String
  patientId      String
  appointmentId  String?
  catalogItemId  String
  dentistId      String?
  /// FDI tooth number (11-48 for permanent teeth). NULL when not applicable
  /// (scaling, whitening, etc.).
  toothNumber    Int?
  /// Surfaces affected — Postgres native array. Empty array = unspecified.
  surfaces       ToothSurface[]
  status         TreatmentApplicationStatus @default(PLANNED)
  /// Captured at creation. `unitPrice * 1 - discount` = line total.
  unitPrice      Decimal                    @db.Decimal(10, 2)
  /// Percentage discount 0-100. Mutually exclusive with `discountAmount`.
  discountPct    Decimal?                   @db.Decimal(5, 2)
  /// Fixed-amount discount in MAD. Mutually exclusive with `discountPct`.
  discountAmount Decimal?                   @db.Decimal(10, 2)
  notes          String?
  /// When the application transitioned to COMPLETED. NULL otherwise.
  performedAt    DateTime?
  createdById    String
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  clinic       Clinic               @relation(fields: [clinicId], references: [id])
  patient      Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment  Appointment?         @relation(fields: [appointmentId], references: [id])
  catalogItem  TreatmentCatalogItem @relation(fields: [catalogItemId], references: [id])
  dentist      Dentist?             @relation(fields: [dentistId], references: [id])
  createdBy    User                 @relation("TreatmentApplicationCreator", fields: [createdById], references: [id])
  invoiceLines InvoiceLine[]

  @@index([clinicId, patientId, createdAt])
  @@index([appointmentId])
  @@index([catalogItemId])
  @@index([status])
  @@map("treatment_applications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Odontogram (Phase 7 — dental chart)
// ─────────────────────────────────────────────────────────────────────────────

/// Per-tooth condition. The chart is append-only: each change creates a new
/// `DentalChartEntry`, and the "current state of tooth N" is the most recent
/// row for `(patientId, toothNumber)`. Old rows form the per-tooth history
/// timeline shown in the side panel.
enum DentalCondition {
  HEALTHY
  CARIES
  FILLING
  CROWN
  IMPLANT
  MISSING
  TO_EXTRACT
  DEVITALIZED
  FRACTURE
  PROSTHESIS

  @@map("dental_condition")
}

/// A single observation/diagnosis on one tooth at one point in time. Multiple
/// surfaces can be affected (e.g. occlusal + distal caries on tooth 26). When
/// the condition is HEALTHY, `surfaces` should be empty.
model DentalChartEntry {
  id           String          @id @default(cuid())
  clinicId     String
  patientId    String
  /// FDI permanent dentition: 11-18, 21-28, 31-38, 41-48. Validated by the
  /// Server Action (the DB cannot enforce a complex range check).
  toothNumber  Int
  condition    DentalCondition
  surfaces     ToothSurface[]
  note         String?
  /// When the observation was made. Defaults to creation but can be backdated
  /// (e.g. recording an existing condition seen on a prior visit).
  recordedAt   DateTime        @default(now())
  recordedById String
  createdAt    DateTime        @default(now())

  clinic     Clinic  @relation(fields: [clinicId], references: [id])
  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("DentalChartRecorder", fields: [recordedById], references: [id])

  @@index([clinicId, patientId, recordedAt])
  @@index([patientId, toothNumber, recordedAt])
  @@map("dental_chart_entries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Prescriptions (Phase 8)
// ─────────────────────────────────────────────────────────────────────────────

/// A medication prescription issued by a dentist to a patient. Rendered to a
/// bilingual PDF (patient locale + Arabic) and shareable by email / WhatsApp.
///
/// `issuedAt` is the official date printed on the document. Edits are
/// permitted up to a couple of days after issue — beyond that, dentists
/// should issue a new prescription rather than rewrite history.
model Prescription {
  id            String   @id @default(cuid())
  clinicId      String
  patientId     String
  /// The prescriber — must be a {@link Dentist} (FK gives that guarantee).
  dentistId     String
  /// Optional link to the appointment during which the prescription was made.
  appointmentId String?
  /// Patient's preferred locale at time of issue — frozen so a later language
  /// switch on the patient profile doesn't rewrite the document.
  locale        String   @default("fr")
  /// Free-text notes printed at the bottom of the prescription (allergies,
  /// special precautions, etc.).
  notes         String?
  issuedAt      DateTime @default(now())
  /// Audit trail: which staff user persisted it (may equal the dentist's User).
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic      Clinic             @relation(fields: [clinicId], references: [id])
  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentist     Dentist            @relation(fields: [dentistId], references: [id])
  appointment Appointment?       @relation(fields: [appointmentId], references: [id])
  createdBy   User               @relation("PrescriptionCreator", fields: [createdById], references: [id])
  items       PrescriptionItem[]

  @@index([clinicId, patientId, issuedAt])
  @@index([dentistId])
  @@index([appointmentId])
  @@map("prescriptions")
}

/// One drug line on a prescription. Kept as free text rather than a drug-DB
/// reference because dentists in Morocco typically prescribe by brand name
/// and dosage in the same string ("Amoxicilline 500 mg").
model PrescriptionItem {
  id             String  @id @default(cuid())
  prescriptionId String
  /// Drug name + strength, exactly as the dentist wants it printed.
  drug           String
  /// Dosage per intake (e.g. "1 gélule", "1 c. à café").
  dosage         String?
  /// Frequency (e.g. "3 fois par jour", "every 8 hours").
  frequency      String?
  /// Duration (e.g. "7 jours", "until pain stops").
  duration       String?
  /// Extra instructions (e.g. "à prendre au repas", "après chaque brossage").
  instructions   String?
  /// Display order on the printed document.
  sortOrder      Int     @default(100)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId, sortOrder])
  @@map("prescription_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing (Phase 9 — invoices + payments + payment plans)
// ─────────────────────────────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  EMITTED
  PARTIAL
  PAID
  VOID

  @@map("invoice_status")
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHECK
  OTHER

  @@map("payment_method")
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("payment_plan_status")
}

enum InstallmentStatus {
  PENDING
  PAID
  CANCELLED

  @@map("installment_status")
}

/// A patient invoice. Lifecycle:
///   DRAFT  → editable, no number yet, no public-facing document
///   EMITTED → number assigned (via the `next_invoice_number` Postgres
///             function — see migration), totals frozen, can record payments
///   PARTIAL → payments recorded but sum < total
///   PAID    → payments fully cover total
///   VOID    → annulled (irreversible, kept for audit)
///
/// `number` is `F-YYYY-NNNN` where NNNN starts at the clinic's
/// `invoiceStartingNumber` to obscure billing volume (cf. SPEC §4.8).
model Invoice {
  id             String        @id @default(cuid())
  clinicId       String
  patientId      String
  /// `F-YYYY-NNNN`. NULL on DRAFT, frozen on EMITTED.
  number         String?
  status         InvoiceStatus @default(DRAFT)
  /// Set when status transitions DRAFT → EMITTED.
  emittedAt      DateTime?
  /// Payment due-by date (defaults to emittedAt + 30 days on emit).
  dueDate        DateTime?
  /// Computed totals captured at write — single source of truth for prints.
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  voidedAt       DateTime?
  voidedReason   String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  clinic      Clinic        @relation(fields: [clinicId], references: [id])
  patient     Patient       @relation(fields: [patientId], references: [id])
  createdBy   User          @relation("InvoiceCreator", fields: [createdById], references: [id])
  lines       InvoiceLine[]
  payments    Payment[]
  paymentPlan PaymentPlan?

  /// `(clinicId, number)` is unique among non-null numbers — Postgres treats
  /// NULLs as distinct, so multiple DRAFTs coexist freely.
  @@unique([clinicId, number])
  @@index([clinicId, status])
  @@index([clinicId, patientId, emittedAt])
  @@index([dueDate])
  @@map("invoices")
}

/// One line on an invoice. May reference a {@link TreatmentApplication} to
/// trace back to the séance; that link is optional so manual one-off lines
/// (lab fees, etc.) still work.
model InvoiceLine {
  id                     String   @id @default(cuid())
  invoiceId              String
  treatmentApplicationId String?
  description            String
  toothNumber            Int?
  quantity               Int      @default(1)
  unitPrice              Decimal  @db.Decimal(10, 2)
  discountPct            Decimal? @db.Decimal(5, 2)
  discountAmount         Decimal? @db.Decimal(10, 2)
  /// Pre-computed line total = qty * unitPrice - discount. Kept on the row so
  /// the printed invoice doesn't recalculate on every render.
  lineTotal              Decimal  @db.Decimal(12, 2)
  sortOrder              Int      @default(100)

  invoice              Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  treatmentApplication TreatmentApplication? @relation(fields: [treatmentApplicationId], references: [id])

  @@index([invoiceId, sortOrder])
  @@map("invoice_lines")
}

/// A payment received against an invoice. May be linked to a payment-plan
/// installment via the unique `installmentId` (1-1 — one payment closes one
/// installment).
model Payment {
  id            String        @id @default(cuid())
  clinicId      String
  invoiceId     String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(CASH)
  /// Free-text reference (check number, transaction id…). Optional.
  reference     String?
  receivedAt    DateTime      @default(now())
  notes         String?
  /// When part of a payment plan, the installment this payment closes.
  installmentId String?       @unique
  createdById   String
  createdAt     DateTime      @default(now())

  invoice     Invoice                 @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  clinic      Clinic                  @relation(fields: [clinicId], references: [id])
  installment PaymentPlanInstallment? @relation(fields: [installmentId], references: [id])
  createdBy   User                    @relation("PaymentCreator", fields: [createdById], references: [id])

  @@index([clinicId, receivedAt])
  @@index([invoiceId])
  @@map("payments")
}

/// Installment payment plan attached to an invoice (1-1). Created when the
/// patient agrees to pay an emitted invoice in N installments. The first
/// installment's date is the user-chosen `startDate`; subsequent ones are
/// spaced 1 month apart by default (action layer can override).
model PaymentPlan {
  id                String            @id @default(cuid())
  clinicId          String
  patientId         String
  invoiceId         String            @unique
  installmentsCount Int
  totalAmount       Decimal           @db.Decimal(12, 2)
  status            PaymentPlanStatus @default(ACTIVE)
  /// First-installment date. Stored as Date (no time) since payment plans
  /// are aligned to days, not minutes.
  startDate         DateTime          @db.Date
  notes             String?
  createdById       String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  clinic       Clinic                   @relation(fields: [clinicId], references: [id])
  patient      Patient                  @relation(fields: [patientId], references: [id])
  invoice      Invoice                  @relation(fields: [invoiceId], references: [id])
  createdBy    User                     @relation("PaymentPlanCreator", fields: [createdById], references: [id])
  installments PaymentPlanInstallment[]

  @@index([clinicId, status])
  @@map("payment_plans")
}

/// One installment of a {@link PaymentPlan}. Status is computed at read time
/// for "OVERDUE" by comparing `dueDate` to `now()` — we only persist the
/// terminal states (PAID/CANCELLED) so we never have to backfill statuses.
/// `reminderJ3SentAt` / `reminderJ1SentAt` are de-dup keys for the cron.
model PaymentPlanInstallment {
  id               String            @id @default(cuid())
  planId           String
  /// 1-based position in the plan.
  sequence         Int
  dueDate          DateTime          @db.Date
  amount           Decimal           @db.Decimal(12, 2)
  status           InstallmentStatus @default(PENDING)
  paidAt           DateTime?
  reminderJ3SentAt DateTime?
  reminderJ1SentAt DateTime?

  plan    PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  payment Payment?

  @@unique([planId, sequence])
  @@index([dueDate, status])
  @@map("payment_plan_installments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Stock (Phase 10 — inventory + movements)
// ─────────────────────────────────────────────────────────────────────────────

enum StockMovementType {
  /// Initial seeding when a new SKU is added with a starting quantity.
  OPENING
  /// Reception of new supplies (purchase).
  PURCHASE
  /// Consumption during patient treatment.
  CONSUMPTION
  /// Inventory correction (count discrepancy, breakage…).
  ADJUSTMENT
  /// Returned to supplier (negative purchase).
  RETURN

  @@map("stock_movement_type")
}

/// A consumable, single-use item, or piece of equipment tracked by the cabinet.
/// Quantity in stock is the algebraic sum of all `StockMovement.quantity`
/// rows for this item — we never write `currentQuantity` directly to avoid
/// drift; UI fetches the live aggregate.
model StockItem {
  id          String    @id @default(cuid())
  clinicId    String
  /// Short SKU/code chosen by the cabinet (e.g. "GANT-S", "ANES-LIDO").
  code        String
  name        String
  description String?
  /// Unit label printed alongside the qty (e.g. "boîte", "ml", "unité").
  unit        String    @default("unité")
  /// Threshold below which the UI flags the item low-stock. NULL = no alert.
  lowStockAt  Int?
  /// Optional best-before date for the current batch (one batch tracked at a
  /// time in V1; multi-batch tracking left for V2 — see SPEC §Hors V1).
  expiresAt   DateTime? @db.Date
  /// Categorise for filtering (e.g. "Consommables", "Anesthésiques", "Implants").
  category    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  clinic    Clinic          @relation(fields: [clinicId], references: [id])
  movements StockMovement[]

  @@unique([clinicId, code])
  @@index([clinicId, isActive])
  @@index([category])
  @@map("stock_items")
}

/// Append-only ledger of stock movements. Positive `quantity` = stock-in,
/// negative = stock-out. We keep both as signed integers so the running total
/// is just `SUM(quantity)`. Adjustments use the sign to indicate direction.
model StockMovement {
  id          String            @id @default(cuid())
  clinicId    String
  itemId      String
  type        StockMovementType
  /// Signed unit count. Validation at the action layer enforces the sign
  /// matches the type (purchases > 0, consumption < 0, etc.).
  quantity    Int
  /// Optional per-unit price for purchases (so total cost can be reported).
  unitPrice   Decimal?          @db.Decimal(10, 2)
  /// Free-text note (supplier, invoice ref, patient name for consumption…).
  note        String?
  recordedAt  DateTime          @default(now())
  createdById String
  createdAt   DateTime          @default(now())

  clinic    Clinic    @relation(fields: [clinicId], references: [id])
  item      StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy User      @relation("StockMovementCreator", fields: [createdById], references: [id])

  @@index([clinicId, recordedAt])
  @@index([itemId, recordedAt])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Recall (Phase 11 — automated follow-up reminders)
// ─────────────────────────────────────────────────────────────────────────────

enum RecallKind {
  /// 6-month scaling/cleaning reminder.
  SCALING
  /// 12-month general check-up reminder.
  ANNUAL_CHECKUP
  /// 3-month post-implant follow-up.
  IMPLANT_FOLLOWUP
  /// 1-month post-extraction healing check.
  POST_EXTRACTION
  /// Free-form custom reminder set by the dentist.
  CUSTOM

  @@map("recall_kind")
}

enum RecallStatus {
  /// Scheduled, not yet sent.
  PENDING
  /// WhatsApp/email message dispatched by the cron.
  SENT
  /// Patient booked a follow-up after the reminder went out (bonus signal).
  APPOINTMENT_BOOKED
  /// Admin disabled the recall.
  DISABLED
  /// Auto-disabled after due date + 30 days with no response.
  EXPIRED

  @@map("recall_status")
}

/// A scheduled follow-up reminder for a patient. Generated automatically when
/// a treatment with `requiresTooth=false` and matching category is performed
/// (scaling → +6 months, etc.) — see `generateRecallsFromApplication` in the
/// recalls server actions module. Admin can override the auto-generation.
model RecallReminder {
  id             String       @id @default(cuid())
  clinicId       String
  patientId      String
  kind           RecallKind
  /// When the reminder should fire (cron checks every day at 09:00).
  dueDate        DateTime     @db.Date
  status         RecallStatus @default(PENDING)
  /// Optional reason printed in the WhatsApp message.
  reason         String?
  /// Timestamp set when the cron dispatches the WhatsApp/email.
  sentAt         DateTime?
  /// Set when a later appointment is detected matching this recall (>= dueDate).
  bookedAt       DateTime?
  /// Manually disabled by staff — kept for audit.
  disabledAt     DateTime?
  disabledReason String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  clinic    Clinic  @relation(fields: [clinicId], references: [id])
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User    @relation("RecallCreator", fields: [createdById], references: [id])

  @@index([clinicId, status, dueDate])
  @@index([patientId, kind])
  @@map("recall_reminders")
}

/// Append-only log of mutations on sensitive entities.
/// Required for loi 09-08 compliance + admin forensics.
model AuditLog {
  id          String   @id @default(cuid())
  clinicId    String
  userId      String?
  action      String
  entity      String
  entityId    String?
  payloadJson Json?
  createdAt   DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI-0 — Event Outbox (transactional event publishing)
// ─────────────────────────────────────────────────────────────────────────────

enum EventStatus {
  /// Inserted in the same DB transaction as the business mutation but not
  /// yet shipped to the orchestrator. The dispatcher cron / post-commit
  /// hook will pick it up.
  PENDING
  /// Successfully forwarded to Inngest. Kept for audit + replay.
  DISPATCHED
  /// Dispatch attempts exhausted — manual intervention via the
  /// `/super-admin/events/replay` UI (future).
  FAILED

  @@map("event_status")
}

/// Outbox row that decouples the business transaction from the
/// orchestrator delivery. Pattern: write the row in the same transaction
/// as the data mutation; a post-commit dispatcher forwards it to Inngest
/// (or any downstream queue). If the dispatcher dies mid-flight, the row
/// stays `PENDING` and replays.
///
/// Why not call Inngest directly from the Server Action? Because the
/// HTTP call would happen *before* the DB transaction commits — if the
/// DB then rollbacks, we'd have emitted a phantom event. Outbox + post-
/// commit dispatch eliminates that race.
model EventOutbox {
  id            String      @id @default(cuid())
  clinicId      String
  /// Event name — dot-namespaced, e.g. "appointment.created",
  /// "invoice.emitted", "recall.generated". Drives Inngest function
  /// routing.
  name          String
  payloadJson   Json
  status        EventStatus @default(PENDING)
  /// When the orchestrator confirmed receipt.
  dispatchedAt  DateTime?
  /// Last error from a failed dispatch — null on PENDING / DISPATCHED.
  lastError     String?
  attempts      Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([status, createdAt])
  @@index([clinicId, name])
  @@map("event_outbox")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI-1 — Conversational booking (WhatsApp)
// ─────────────────────────────────────────────────────────────────────────────

enum AIConversationStatus {
  /// Bot is actively handling the conversation.
  ACTIVE
  /// Admin took over from the dashboard — the bot must stop replying
  /// even if new messages come in.
  HANDED_OFF
  /// Idle for > N days, or patient explicitly closed it. Lookup still
  /// works (e.g. for audit) but no further bot replies.
  CLOSED

  @@map("ai_conversation_status")
}

/// One row per (clinic × WhatsApp phone). Stores the rolling conversation
/// history that the engine feeds back into the model on each new inbound
/// message so the bot remembers earlier turns.
///
/// The `patientId` link is nullable on purpose: a brand-new number messages
/// the cabinet *before* it exists in the patient DB. The webhook handler
/// resolves it lazily — first by exact phone match, then by asking the
/// patient to identify themselves. Once resolved we store the id here so
/// tools like `create_appointment` and `list_my_appointments` can act on
/// the right patient.
///
/// `historyJson` is the canonical ChatMessage[] (system prompt stripped —
/// it is rebuilt fresh each turn so we can evolve it without rewriting
/// stored rows). Cap enforced by the engine, not by the schema.
model AIConversation {
  id              String               @id @default(cuid())
  clinicId        String
  /// E.164 normalised number, e.g. "+212638256271". Unique within a
  /// clinic so we never accidentally double-track a patient.
  patientPhone    String
  patientId       String?
  status          AIConversationStatus @default(ACTIVE)
  /// Rolling array of `ChatMessage` objects (typed in TS but stored as
  /// JSON here so we don't fight Prisma's typed JSON support).
  historyJson     Json                 @default("[]")
  /// Cumulative count across the conversation's lifetime — used in the
  /// admin UI to flag chatty conversations.
  totalTurns      Int                  @default(0)
  /// Sum of tokens consumed by the AI cascade. Powers the per-clinic
  /// quota UI (free tier guardrail).
  totalTokens     Int                  @default(0)
  /// When the LAST inbound message landed — drives "recent
  /// conversations" sorting + auto-close cron.
  lastActivityAt  DateTime             @default(now())
  /// When the LAST *patient* (inbound) message landed. Used together
  /// with `lastReadAt` to compute the unread badge: a conversation is
  /// unread iff `lastInboundAt > lastReadAt`.
  lastInboundAt   DateTime?
  /// When an admin last opened this conversation in the dashboard.
  /// `null` = never opened (treat any inbound as unread).
  lastReadAt      DateTime?
  /// When an admin clicked "Take over" — set together with status =
  /// HANDED_OFF. Null otherwise.
  handedOffAt     DateTime?
  handedOffById   String?
  /// Coexistence Mode — set every time the cabinet owner sends a message
  /// from their mobile WhatsApp Business app. The webhook detects these
  /// (sender === WABA's own number) and the AI handler suppresses bot
  /// replies for `HUMAN_HANDOFF_WINDOW_MS` after this timestamp so the
  /// dentist and the bot don't double-reply to the patient. Null until
  /// the first owner-mobile message lands.
  lastHumanReplyAt DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  clinic          Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient?             @relation(fields: [patientId], references: [id], onDelete: SetNull)
  handedOffBy     User?                @relation("AIConversationHandover", fields: [handedOffById], references: [id], onDelete: SetNull)

  @@unique([clinicId, patientPhone])
  @@index([clinicId, lastActivityAt])
  @@index([clinicId, status])
  @@index([patientId])
  @@map("ai_conversation")
}

// ─────────────────────────────────────────────────────────────────────────────
// Support tickets — cabinets ↔ super-admin two-way conversation
// ─────────────────────────────────────────────────────────────────────────────

/// Lifecycle of a support thread. State machine:
///   OPEN → IN_PROGRESS (super-admin replied) → WAITING_USER (cabinet replied)
///   ↔ IN_PROGRESS ↔ WAITING_USER (back-and-forth) → RESOLVED (closed)
/// Either side can RESOLVE; either side can re-open by adding a reply.
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED

  @@map("support_ticket_status")
}

/// Severity hint — super-admin sorts the inbox by this.
enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("support_ticket_priority")
}

/// Used by the cabinet's "submit a ticket" form. Drives the inbox
/// filter on the super-admin side ("show me all WhatsApp issues").
enum SupportTicketCategory {
  /// "I can't add a patient", form errors, broken UI.
  TECHNICAL_BUG
  /// "How do I configure recalls?", training questions.
  HOW_TO
  /// Plan changes, invoices, payment failures.
  BILLING
  /// WhatsApp Cloud API setup, templates, webhook problems.
  WHATSAPP
  /// "Please add X feature".
  FEATURE_REQUEST
  /// User account, password, permissions.
  ACCOUNT
  OTHER

  @@map("support_ticket_category")
}

/// One support thread. The originating message lives in `body`;
/// follow-ups live in `SupportTicketReply` rows. We keep the
/// original separate so the inbox can show "subject + first line"
/// without a JOIN.
model SupportTicket {
  id          String                 @id @default(cuid())
  clinicId    String
  /// Cabinet user (admin / dentist / réceptionniste) who opened it.
  createdById String
  subject     String                 @db.VarChar(160)
  body        String                 @db.Text
  category    SupportTicketCategory  @default(OTHER)
  priority    SupportTicketPriority  @default(NORMAL)
  status      SupportTicketStatus    @default(OPEN)
  /// When super-admin set status = RESOLVED. Null while open.
  resolvedAt  DateTime?
  /// When either side last added a reply (or the ticket was created).
  /// Used for the inbox "Last activity" column + outer ORDER BY.
  lastActivityAt DateTime            @default(now())
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  clinic    Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("SupportTicketCreator", fields: [createdById], references: [id])
  replies   SupportTicketReply[]

  @@index([clinicId, status])
  @@index([status, lastActivityAt])
  @@index([priority, lastActivityAt])
  @@map("support_tickets")
}

/// One reply in a ticket thread. `isFromSuperAdmin` lets us style
/// bubbles per side without re-querying the user's role on render.
model SupportTicketReply {
  id               String   @id @default(cuid())
  ticketId         String
  userId           String
  body             String   @db.Text
  isFromSuperAdmin Boolean  @default(false)
  createdAt        DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation("SupportTicketReplyAuthor", fields: [userId], references: [id])

  @@index([ticketId, createdAt])
  @@map("support_ticket_replies")
}

/// Platform-wide announcement set by the super-admin and shown as a banner
/// to every cabinet user (maintenance notice, product update…). Only the
/// most recent `active` row is displayed; publishing a new one deactivates
/// the rest.
model PlatformAnnouncement {
  id          String            @id @default(cuid())
  message     String
  level       AnnouncementLevel @default(INFO)
  active      Boolean           @default(true)
  createdById String
  createdAt   DateTime          @default(now())

  @@index([active, createdAt])
  @@map("platform_announcements")
}

enum AnnouncementLevel {
  INFO
  WARNING

  @@map("announcement_level")
}

/// Subscription invoice issued BY the platform TO a cabinet for its plan
/// (a billing ledger; online collection is a separate future concern).
/// Amount/period snapshot the plan price at issue time so historical rows
/// stay correct after a tariff change.
model SubscriptionInvoice {
  id          String              @id @default(cuid())
  clinicId    String
  plan        SubscriptionPlan
  amount      Int
  period      String
  status      SubInvoiceStatus    @default(ISSUED)
  issuedAt    DateTime            @default(now())
  paidAt      DateTime?
  createdById String

  @@index([clinicId, issuedAt])
  @@map("subscription_invoices")
}

enum SubInvoiceStatus {
  ISSUED
  PAID

  @@map("sub_invoice_status")
}

/// Discount coupon managed by the super-admin (P2-11). Codes are stored
/// ready for redemption once online billing is wired; the `redemptions`
/// counter + `maxRedemptions` cap and `expiresAt` already model validity.
model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType
  value          Int
  maxRedemptions Int?
  redemptions    Int        @default(0)
  active         Boolean    @default(true)
  expiresAt      DateTime?
  createdById    String
  createdAt      DateTime   @default(now())

  @@map("coupons")
}

enum CouponType {
  PERCENT
  FIXED

  @@map("coupon_type")
}
