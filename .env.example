# Neon Postgres connection strings
# Pooled (use for runtime queries via Prisma Client)
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require"

# Direct (use for migrations and Prisma Studio — no pgbouncer)
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require"

# Auth.js v5 — generate via: openssl rand -base64 32
AUTH_SECRET="replace-me-32-bytes-base64"
AUTH_TRUST_HOST="true"

# Seed default credentials — change in production
SEED_ADMIN_EMAIL="admin@dentalcare-fes.ma"
SEED_ADMIN_PASSWORD="ChangeMe!"
SEED_DENTIST_EMAIL="dentist@dentalcare-fes.ma"
SEED_DENTIST_PASSWORD="ChangeMe!"
SEED_RECEPTIONIST_EMAIL="receptionist@dentalcare-fes.ma"
SEED_RECEPTIONIST_PASSWORD="ChangeMe!"

# WhatsApp Cloud API (Meta) — leave blank in dev (messages logged to console)
# Get these from Meta Business Manager → WhatsApp → API Setup
WHATSAPP_TOKEN=""              # System User Token
WHATSAPP_PHONE_ID=""           # Phone Number ID (not the phone number itself)
WHATSAPP_APP_SECRET=""         # App secret for webhook HMAC verification
WHATSAPP_VERIFY_TOKEN=""       # Random string you choose, set in Meta webhook config

# Cron secret — protects /api/cron/* endpoints from public access
# Use: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# Public URL for outbound links (reset password, WhatsApp confirm buttons)
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary — radiographs + before/after photos storage (Phase 5)
# Dev: leave blank to use a local fallback (images persisted under public/_uploads).
# Prod: create a Cloudinary account → dashboard → API Keys. Folder is auto-namespaced
# per clinic. Server-only — never expose CLOUDINARY_API_SECRET to the client.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ────────────────────────────────────────────────────────────────────────────
# Phase 13 — Production-ready stack
# ────────────────────────────────────────────────────────────────────────────

# Resend — transactional email (password reset, invoice, alerts)
# Dev: leave blank → emails go to the console log.
# Prod: create an account at https://resend.com, add+verify your domain (DNS
# records: MX, SPF/TXT, DKIM, DMARC), then issue an API key. Until your domain
# is verified you can use `onboarding@resend.dev` to test.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@your-domain.ma"
RESEND_FROM_NAME="DentalCare"

# Sentry — error monitoring & performance (https://sentry.io)
# Dev: leave blank → no-op (no events sent).
# Prod: create a Next.js project, copy the DSN. Add SENTRY_AUTH_TOKEN as a
# build-time Vercel secret so source maps upload (much better stack traces).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Upstash Redis — distributed rate limiting (https://upstash.com)
# Dev: leave blank → falls back to in-memory rate limiter (per-process, fine
# for `pnpm dev` but useless on Vercel serverless where each request may hit
# a different instance).
# Prod: REQUIRED. Create a Redis database (free tier 10K commands/day), copy
# the REST URL + token from the Upstash console.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ────────────────────────────────────────────────────────────────────────────
# AI-0 — AI provider cascade + event orchestrator
# ────────────────────────────────────────────────────────────────────────────

# Google Gemini 2.0 Flash — primary provider (1500 free requests/day).
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL=""        # leave blank for the cascade default

# Groq Llama 3.3 70B — fallback when Gemini returns 429 / 5xx / timeout.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL=""          # leave blank for the cascade default

# Inngest event orchestrator — used by the EventOutbox pipeline.
# Dev: run `npx inngest-cli dev` for a local dashboard; signingKey optional.
# Prod: sign up at https://www.inngest.com and copy the event/signing keys.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
